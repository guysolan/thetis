---
import BregDeckSlides from "@/components/oped-deck/BregDeckSlides.astro";
import OpedDeckLayout from "@/layouts/OpedDeckLayout.astro";
import {
  BREG_DECK_BASE_PATH,
  BREG_DECK_SLIDE_COUNT,
} from "@/features/oped-deck/bregDeckPitchContent";

const rawPage = Number.parseInt(Astro.params.page ?? "1", 10);

if (!Number.isFinite(rawPage) || rawPage < 1) {
  return Astro.redirect(`${BREG_DECK_BASE_PATH}/1`, 301);
}

if (rawPage > BREG_DECK_SLIDE_COUNT) {
  return Astro.redirect(
    `${BREG_DECK_BASE_PATH}/${BREG_DECK_SLIDE_COUNT}`,
    301,
  );
}

const initialPage = rawPage;
---

<OpedDeckLayout
  title="Achilles Recovery - Breg x Thetis"
  description="Confidential partnership overview for Breg and Thetis Medical."
  initialPage={initialPage}
  slideCount={BREG_DECK_SLIDE_COUNT}
  basePath={BREG_DECK_BASE_PATH}
  partnerName="Breg"
  partnerLogo="/images/breg/breg-logo.svg"
>
  <BregDeckSlides initialPage={initialPage} />
</OpedDeckLayout>
