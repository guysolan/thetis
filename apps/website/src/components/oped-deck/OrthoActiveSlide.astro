---
import ColorGradient from "@/components/ColorGradient.astro";
import DeckSection from "./DeckSection.astro";
import OpedProofCards from "./OpedProofCards.astro";
import OpedSalesGrowthChart from "./OpedSalesGrowthChart.astro";
import PitchStatGrid from "./PitchStatGrid.astro";
import {
  orthoActivePitchClinics,
  orthoActivePitchClose,
  orthoActivePitchDigital,
  orthoActivePitchFliers,
  orthoActivePitchLevers,
  orthoActivePitchMix,
  orthoActivePitchPricing,
  orthoActivePitchReimbursement,
  orthoActivePitchSalesChart,
  orthoActivePitchTitle,
} from "@/features/oped-deck/orthoActiveDeckPitchContent";

interface Props {
  page: number;
}

const { page } = Astro.props;
---

{
  page === 1 && (
    <div class="pb-20 w-full min-h-[calc(100vh-57px)]">
      <div class="[&_.color-gradient]:!pt-6">
        <ColorGradient>
          <div class="mx-auto px-6 md:px-12 lg:px-24 py-6 md:py-10 w-full max-w-6xl text-center">
            <p class="mb-6 font-medium text-primary text-sm uppercase tracking-widest">
              {orthoActivePitchTitle.eyebrow}
            </p>
            <div class="relative mx-auto mb-6 w-full max-w-[11rem] md:max-w-48">
              <div
                class="absolute -inset-3 bg-primary/10 blur-2xl rounded-3xl"
                aria-hidden="true"
              />
              <img
                src="/images/night_splint_bed_top_square.jpg"
                alt="Thetis Achilles rupture night splint"
                width="640"
                height="640"
                class="relative shadow-md border border-white/70 rounded-2xl w-full object-cover aspect-square"
              />
            </div>
            <h1 class="mx-auto mb-4 w-full max-w-6xl font-semibold text-neutral-900 text-3xl md:text-4xl lg:text-5xl text-balance leading-[1.1] tracking-tight">
              {orthoActivePitchTitle.title}
            </h1>
            <p class="mx-auto w-full max-w-5xl text-neutral-600 text-lg md:text-xl leading-snug">
              {orthoActivePitchTitle.subtitle}
            </p>
          </div>
        </ColorGradient>
      </div>
    </div>
  )
}

{
  page === 2 && (
    <DeckSection
      title={orthoActivePitchMix.title}
      intro={orthoActivePitchMix.intro}
      eyebrow={orthoActivePitchMix.eyebrow}
      gradient
    >
      <div class="space-y-6 mx-auto max-w-5xl">
        <PitchStatGrid stats={orthoActivePitchMix.stats} columns={4} />
        <OpedSalesGrowthChart chart={orthoActivePitchSalesChart} />
      </div>
    </DeckSection>
  )
}

{
  page === 3 && (
    <DeckSection
      title={orthoActivePitchLevers.title}
      intro={orthoActivePitchLevers.intro}
      eyebrow={orthoActivePitchLevers.eyebrow}
      gradient
    >
      <ul class="gap-4 grid md:grid-cols-2">
        {orthoActivePitchLevers.items.map((item) => (
          <li class="bg-white dark:bg-neutral-900 shadow-sm p-5 border border-neutral-200 dark:border-neutral-700 rounded-xl">
            <p class="mb-2 font-bold text-primary text-sm uppercase tracking-widest">
              Lever {item.number}
            </p>
            <h3 class="mb-1 font-bold text-neutral-900 dark:text-neutral-100 text-xl leading-snug">
              {item.title}
            </h3>
            <p class="mb-2 font-medium text-primary text-base">
              {item.channel}
            </p>
            <p class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
              {item.detail}
            </p>
          </li>
        ))}
      </ul>
    </DeckSection>
  )
}

{
  page === 4 && (
    <DeckSection
      title={orthoActivePitchDigital.title}
      intro={orthoActivePitchDigital.intro}
      eyebrow={orthoActivePitchDigital.eyebrow}
      gradient
    >
      <div class="space-y-6 mx-auto max-w-5xl">
        <PitchStatGrid stats={orthoActivePitchDigital.stats} columns={4} />
        <ul class="gap-3 grid md:grid-cols-3">
          {orthoActivePitchDigital.channels.map((channel) => (
            <li class="bg-white dark:bg-neutral-900 shadow-sm p-4 border border-neutral-200 dark:border-neutral-700 rounded-xl">
              <p class="mb-1 font-bold text-neutral-900 dark:text-neutral-100 text-base">
                {channel.label}
              </p>
              <p class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
                {channel.detail}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </DeckSection>
  )
}

{
  page === 5 && (
    <DeckSection
      title={orthoActivePitchFliers.title}
      intro={orthoActivePitchFliers.intro}
      eyebrow={orthoActivePitchFliers.eyebrow}
      gradient
    >
      <div class="space-y-6 mx-auto max-w-5xl">
        <ul class="gap-3 grid md:grid-cols-3">
          {orthoActivePitchFliers.tactics.map((tactic) => (
            <li class="bg-white dark:bg-neutral-900 shadow-sm p-5 border border-neutral-200 dark:border-neutral-700 rounded-xl">
              <p class="mb-2 font-bold text-neutral-900 dark:text-neutral-100 text-lg">
                {tactic.label}
              </p>
              <p class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
                {tactic.detail}
              </p>
            </li>
          ))}
        </ul>
        <div class="relative bg-primary/10 shadow-sm p-4 md:p-5 border border-primary/30 rounded-xl overflow-hidden">
          <div
            class="left-0 absolute inset-y-0 bg-primary w-1.5"
            aria-hidden="true"
          />
          <p class="mb-1 font-bold text-primary text-xs uppercase tracking-[0.14em]">
            {orthoActivePitchFliers.proof.label}
          </p>
          <p class="font-semibold text-neutral-900 dark:text-neutral-100 text-base md:text-lg leading-snug">
            {orthoActivePitchFliers.proof.headline}
          </p>
          <p class="mt-1.5 text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
            {orthoActivePitchFliers.proof.detail}
          </p>
        </div>
      </div>
    </DeckSection>
  )
}

{
  page === 6 && (
    <DeckSection
      title={orthoActivePitchPricing.title}
      intro={orthoActivePitchPricing.intro}
      eyebrow={orthoActivePitchPricing.eyebrow}
      gradient
    >
      <div class="space-y-6 mx-auto max-w-5xl">
        <ul class="gap-4 grid md:grid-cols-3">
          {orthoActivePitchPricing.routes.map((route) => (
            <li class="flex flex-col bg-white dark:bg-neutral-900 shadow-sm p-5 border border-neutral-200 dark:border-neutral-700 rounded-xl">
              <p class="font-medium text-primary text-sm uppercase tracking-widest">
                {route.status}
              </p>
              <p class="mt-1 mb-3 font-bold text-neutral-900 dark:text-neutral-100 text-2xl leading-snug">
                {route.label}
              </p>
              <p class="mt-auto text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
                {route.detail}
              </p>
            </li>
          ))}
        </ul>
        <div class="relative bg-primary/10 shadow-sm p-4 md:p-5 border border-primary/30 rounded-xl overflow-hidden">
          <div
            class="left-0 absolute inset-y-0 bg-primary w-1.5"
            aria-hidden="true"
          />
          <p class="mb-1 font-bold text-primary text-xs uppercase tracking-[0.14em]">
            {orthoActivePitchPricing.saving.label}
          </p>
          <p class="font-semibold text-neutral-900 dark:text-neutral-100 text-base md:text-lg leading-snug">
            {orthoActivePitchPricing.saving.headline}
          </p>
          <p class="mt-1.5 text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
            {orthoActivePitchPricing.saving.detail}
          </p>
        </div>
      </div>
    </DeckSection>
  )
}

{
  page === 7 && (
    <DeckSection
      title={orthoActivePitchReimbursement.title}
      intro={orthoActivePitchReimbursement.intro}
      eyebrow={orthoActivePitchReimbursement.eyebrow}
      gradient
    >
      <div class="space-y-6 mx-auto max-w-5xl">
        <ul class="gap-3 grid md:grid-cols-3">
          {orthoActivePitchReimbursement.paths.map((path) => (
            <li class="bg-white dark:bg-neutral-900 shadow-sm p-5 border border-neutral-200 dark:border-neutral-700 rounded-xl">
              <p class="font-medium text-primary text-sm uppercase tracking-widest">
                {path.market}
              </p>
              <h3 class="mt-1 mb-2 font-bold text-neutral-900 dark:text-neutral-100 text-xl leading-snug">
                {path.name}
              </h3>
              <p class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
                {path.detail}
              </p>
            </li>
          ))}
        </ul>
        <div class="relative bg-primary/10 shadow-sm p-4 md:p-5 border border-primary/30 rounded-xl overflow-hidden">
          <div
            class="left-0 absolute inset-y-0 bg-primary w-1.5"
            aria-hidden="true"
          />
          <p class="mb-1 font-bold text-primary text-xs uppercase tracking-[0.14em]">
            {orthoActivePitchReimbursement.unlock.label}
          </p>
          <p class="font-semibold text-neutral-900 dark:text-neutral-100 text-base md:text-lg leading-snug">
            {orthoActivePitchReimbursement.unlock.headline}
          </p>
          <p class="mt-1.5 text-neutral-600 dark:text-neutral-400 text-base leading-relaxed">
            {orthoActivePitchReimbursement.unlock.detail}
          </p>
        </div>
      </div>
    </DeckSection>
  )
}

{
  page === 8 && (
    <DeckSection
      title={orthoActivePitchClinics.title}
      intro={orthoActivePitchClinics.intro}
      eyebrow={orthoActivePitchClinics.eyebrow}
      gradient
    >
      <OpedProofCards />
    </DeckSection>
  )
}

{
  page === 9 && (
    <DeckSection
      title={orthoActivePitchClose.title}
      intro={orthoActivePitchClose.intro}
      eyebrow={orthoActivePitchClose.eyebrow}
      gradient
    >
      <div class="space-y-6 mx-auto max-w-5xl">
        <ul class="gap-4 grid md:grid-cols-2">
          {orthoActivePitchLevers.items.map((item) => (
            <li class="bg-white dark:bg-neutral-900 shadow-sm p-5 border border-neutral-200 dark:border-neutral-700 rounded-xl">
              <p class="mb-1 font-bold text-primary text-sm uppercase tracking-widest">
                Lever {item.number}
              </p>
              <h3 class="font-bold text-neutral-900 dark:text-neutral-100 text-xl leading-snug">
                {item.title}
              </h3>
              <p class="mt-1 text-neutral-500 dark:text-neutral-400 text-base">
                {item.channel}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </DeckSection>
  )
}
