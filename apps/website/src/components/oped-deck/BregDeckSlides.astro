---
import BregSlide from "./BregSlide.astro";
import { BREG_DECK_SLIDE_COUNT } from "@/features/oped-deck/bregDeckPitchContent";

interface Props {
  initialPage: number;
}

const { initialPage } = Astro.props;
---

{
  Array.from({ length: BREG_DECK_SLIDE_COUNT }, (_, index) => {
    const page = index + 1;
    return (
      <div
        data-oped-slide={page}
        class="oped-slide-panel"
        hidden={page !== initialPage}
      >
        <BregSlide page={page} />
      </div>
    );
  })
}
