---
interface Props {
  chart: {
    title: string;
    subtitle: string;
    history: readonly { year: string; units: number }[];
    projection?: {
      year: string;
      yearLabel: string;
      units: number;
      partnerLabel: string;
    };
  };
}

const { chart } = Astro.props;
const projection = chart.projection;

const historyPoints = chart.history.map((entry) => ({
  ...entry,
  projected: false as const,
  yearLabel: entry.year,
}));

const points = projection
  ? [
      ...historyPoints,
      {
        year: projection.year,
        yearLabel: projection.yearLabel,
        units: projection.units,
        projected: true as const,
      },
    ]
  : historyPoints;

const width = 640;
const height = 280;
const pad = { top: 28, right: 24, bottom: 56, left: 44 };
const plotW = width - pad.left - pad.right;
const plotH = height - pad.top - pad.bottom;
const maxUnits = Math.max(...points.map((point) => point.units));
const yAxisMax = maxUnits <= 3000 ? 3000 : 5000;
const yTicks =
  yAxisMax === 3000
    ? [0, 1000, 2000, 3000]
    : [0, 1000, 2000, 3000, 4000, 5000];

function xAt(index: number) {
  const last = Math.max(points.length - 1, 1);
  return pad.left + (index / last) * plotW;
}

function yAt(units: number) {
  return pad.top + plotH - (units / yAxisMax) * plotH;
}

const solidEnd = projection ? points.length - 1 : points.length;
const solidPath = points
  .slice(0, solidEnd)
  .map(
    (point, index) =>
      `${index === 0 ? "M" : "L"} ${xAt(index)} ${yAt(point.units)}`,
  )
  .join(" ");

const projectionPath =
  projection && points.length >= 2
    ? `M ${xAt(points.length - 2)} ${yAt(points[points.length - 2].units)} L ${xAt(points.length - 1)} ${yAt(points[points.length - 1].units)}`
    : null;
---

<div
  class="bg-white dark:bg-neutral-900 shadow-sm p-5 border border-neutral-200 dark:border-neutral-700 rounded-xl"
>
  <div class="mb-5">
    <h3
      class="font-semibold text-neutral-900 dark:text-neutral-100 text-sm uppercase tracking-widest"
    >
      {chart.title}
    </h3>
    <p class="mt-1 text-neutral-500 text-xs">
      {chart.subtitle}
    </p>
  </div>

  <svg
    viewBox={`0 0 ${width} ${height}`}
    class="w-full h-auto"
    role="img"
    aria-label={`${chart.title}. ${points.map((point) => `${point.yearLabel}: ${point.units.toLocaleString("en-GB")}`).join(". ")}`}
  >
    {
      yTicks.map((value) => {
        const y = yAt(value);
        return (
          <g>
            <line
              x1={pad.left}
              y1={y}
              x2={width - pad.right}
              y2={y}
              class="stroke-neutral-100 dark:stroke-neutral-800"
              stroke-width="1"
            />
            <text
              x={pad.left - 8}
              y={y + 4}
              text-anchor="end"
              class="fill-neutral-400 text-[10px]"
            >
              {value.toLocaleString("en-GB")}
            </text>
          </g>
        );
      })
    }

    <path
      d={solidPath}
      fill="none"
      class="stroke-primary"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>

    {
      projectionPath && (
        <path
          d={projectionPath}
          fill="none"
          class="stroke-primary"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-dasharray="6 5"
        />
      )
    }

    {
      points.map((point, index) => (
        <text
          x={xAt(index)}
          y={height - 18}
          text-anchor="middle"
          class:list={[
            "text-[10px]",
            point.projected ? "fill-primary font-semibold" : "fill-neutral-500",
          ]}
        >
          {point.yearLabel}
        </text>
      ))
    }
  </svg>

  {
    projection && (
      <p class="mt-3 text-[11px] text-neutral-500 text-center">
        Dotted line = projected volume with {projection.partnerLabel}{" "}
        distribution
      </p>
    )
  }
</div>
